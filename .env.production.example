# Copy to .env.production; keep the result private and never commit it.
# The domain needs DNS pointing to this server, and ports 80/443 available.
APP_DOMAIN=subscription.example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
APP_TIMEZONE=Asia/Shanghai

# Optional external notification settings (leave unset to disable).
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM=
NOTIFY_SMTP_TO=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_BARK_DEVICE_KEY=

# Optional encrypted remote backups. Initialize the Restic repository first.
# Example: s3:https://your-s3-endpoint.example.com/bucket/subscription-hub
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
