# Copy to .env.production; keep the result private and never commit it.
# Nginx listens on Docker port 80 and binds to host loopback port 18080.
# If using the Compose tunnel profile, configure the token below and route
# your public hostname to http://web:80 in Cloudflare Zero Trust.
# If cloudflared runs on the host, use http://127.0.0.1:18080 instead.
HTTP_BIND=127.0.0.1:18080
CLOUDFLARE_TUNNEL_TOKEN=
ADMIN_PASSWORD=replace-with-a-strong-unique-password
APP_TIMEZONE=Asia/Shanghai

# Optional external notification settings (leave unset to disable).
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM=
NOTIFY_SMTP_TO=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_BARK_DEVICE_KEY=

# Optional encrypted remote backups. Initialize the Restic repository first.
# Example: s3:https://your-s3-endpoint.example.com/bucket/subscription-hub
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
